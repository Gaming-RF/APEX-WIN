[Unit]
Description=APEX-WIN Background Daemon — transparent Windows .exe execution via Wine
Documentation=https://github.com/Gaming-RF/APEX-WIN
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/win-sandbox-runner --daemon
ExecStop=/usr/bin/win-sandbox-runner --stop
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=win-sandbox

# Runtime directory (systemd creates /run/win-sandbox-runner before ExecStart)
RuntimeDirectory=win-sandbox-runner
RuntimeDirectoryMode=1777

# Security hardening
ProtectHome=read-only
ReadWritePaths=/run/win-sandbox-runner /tmp

[Install]
WantedBy=multi-user.target
